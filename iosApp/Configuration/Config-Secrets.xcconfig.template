// Template for Config-Secrets.xcconfig — COPY, don't edit in place:
//
//     cp Config-Secrets.xcconfig.template Config-Secrets.xcconfig
//
// The real Config-Secrets.xcconfig is gitignored. Config.xcconfig pulls it in
// with an optional `#include?`, so a fresh clone still builds without it — the
// Meta SDK simply stays disabled (see MetaBridge.swift).
//
// These mirror META_APP_ID / META_CLIENT_TOKEN in local.properties, which feed
// the Android build. Keep the two in sync.

// Meta (Facebook) app id. Public — it also forms the fb<APPID> URL scheme.
FACEBOOK_APP_ID = 6761425705

// Meta client token: developers.facebook.com -> App -> Settings -> Advanced -> Client token.
// NOTE: xcconfig treats `//` as a comment. Tokens are alphanumeric, so this is
// not normally an issue, but never wrap the value in quotes.
FACEBOOK_CLIENT_TOKEN =
