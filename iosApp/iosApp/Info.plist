<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>IS_STAGING</key>
	<string>$(IS_STAGING)</string>
	<key>CFBundleDisplayName</key>
	<string>$(BUNDLE_DISPLAY_NAME)</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Local uses your location to show nearby events, restaurants and experiences.</string>
	<key>UIAppFonts</key>
	<array>
		<string>nunito_variable.ttf</string>
		<string>fraunces_variable.ttf</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>SplashCream</string>
	</dict>
	<!-- Meta (Facebook) SDK. Values are substituted at build time from
	     Config-Secrets.xcconfig (gitignored) via Config.xcconfig, so no key is
	     committed. FBSDKCoreKit reads FacebookAppID/FacebookClientToken itself
	     when ApplicationDelegate is initialized. -->
	<key>FacebookAppID</key>
	<string>$(FACEBOOK_APP_ID)</string>
	<key>FacebookClientToken</key>
	<string>$(FACEBOOK_CLIENT_TOKEN)</string>
	<key>FacebookDisplayName</key>
	<string>Local</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fb$(FACEBOOK_APP_ID)</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
